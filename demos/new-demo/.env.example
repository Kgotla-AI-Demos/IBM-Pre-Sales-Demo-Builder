# Demo environment — copy to .env and fill in values
# ─────────────────────────────────────────────────
# DEMO MODE
# ─────────────────────────────────────────────────
DEMO_MODE=mock

# ─────────────────────────────────────────────────
# FRONTEND (VITE_ vars are embedded at build time)
# ─────────────────────────────────────────────────
# Local dev: leave as /api (Vite proxies /api → localhost:8000)
# Netlify + Code Engine: set to your Code Engine app URL, e.g.:
#   VITE_API_BASE_URL=https://factory-ai-backend.us-south.codeengine.appdomain.cloud/api
VITE_API_BASE_URL=http://localhost:8000/api

VITE_DEMO_TITLE=Factory AI Predictive Maintenance — Built with IBM watsonx
VITE_DEMO_CLIENT_CODE=DEMO-MFG-001

# ─────────────────────────────────────────────────
# IBM watsonx.ai (leave blank for mock mode)
# ─────────────────────────────────────────────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# ─────────────────────────────────────────────────
# IBM Cloud Code Engine (backend deployment)
# ─────────────────────────────────────────────────
# Set these in your shell before running scripts/deploy-codengine.sh
IBMCLOUD_API_KEY=
CODE_ENGINE_PROJECT=factory-ai-demo
CODE_ENGINE_REGION=us-south
CODE_ENGINE_APP_NAME=factory-ai-backend
# Your IBM Cloud Container Registry namespace
ICR_NAMESPACE=

# ─────────────────────────────────────────────────
# CORS — Code Engine backend must allow your Netlify domain
# e.g.: CORS_ORIGINS=https://factory-ai-demo.netlify.app,http://localhost:5173
# ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
